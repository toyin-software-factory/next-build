{
  "name": "next-build",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "pnpm db:migrate:local && next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && pnpm db:migrate:local && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare upload",
    "deploy:preview": "wrangler preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "access:token": "node scripts/access-token.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --config wrangler.preview-migrations.jsonc",
    "db:reset:preview": "node scripts/db-reset-preview.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@opennextjs/cloudflare": "1.20.17",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.17",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "vitest-axe": "0.1.0",
    "wrangler": "4.158.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "preserveUnused": true
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --fix --no-warn-ignored --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,jsonc,css,md,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
