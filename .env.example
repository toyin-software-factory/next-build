# Copy to .env.local for local builds. .env.local is git ignored.
# Public values, inlined into the client bundle at build time.
# Canonical site URL for SEO. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare's published Turnstile test site key (always passes). The real one is a Workers Builds build variable, production only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Optional: force production or preview. Normally resolved from WORKERS_CI_BRANCH in next.config.ts.
# APP_ENV=preview
