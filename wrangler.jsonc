{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "next-build",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "next-build",
      "database_id": "684985c3-e937-4b24-8e33-cda0ee39b87c",
      "migrations_dir": "drizzle",
    },
  ],
  // Best effort flood control for posting and voting (per Cloudflare location).
  // Burst limits (spec 0007): 3 posts per 60 seconds, 30 votes per 10 seconds, per client address.
  "ratelimits": [
    { "name": "POST_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 3, "period": 60 } },
    {
      "name": "VOTE_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": { "limit": 30, "period": 10 },
    },
  ],
  // No plain vars. ACCESS_TEAM_DOMAIN, ACCESS_AUD, ADMIN_EMAIL and TURNSTILE_SECRET_KEY are set in
  // Cloudflare (dashboard secrets) and, locally, in .dev.vars. A placeholder here would collide.
  // Worker Previews (`wrangler preview`) do not inherit the settings above, so everything
  // a preview needs is declared here. Previews bind DB to next-build-preview, never production.
  "previews": {
    "observability": { "enabled": true },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "next-build-preview",
        "database_id": "ddf3ab27-fa82-4a70-b5f4-f9dfaf87ae87",
        "migrations_dir": "drizzle",
      },
    ],
    "ratelimits": [
      {
        "name": "POST_RATE_LIMITER",
        "namespace_id": "2003",
        "simple": { "limit": 3, "period": 60 },
      },
      {
        "name": "VOTE_RATE_LIMITER",
        "namespace_id": "2004",
        "simple": { "limit": 30, "period": 10 },
      },
    ],
  },
}
