{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "next-build",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // Production database. TODO(FSD-T01): placeholder id. Replace with the real
  // `next-build` database id once Toyin creates it (ids are not secret).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "next-build",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "drizzle",
    },
  ],
  // Best effort flood control for posting and voting (per Cloudflare location).
  // The limits are provisional: scope feature 9 sets them.
  "ratelimits": [
    { "name": "POST_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
    {
      "name": "VOTE_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // Plain vars only. Secrets (ACCESS_AUD, ADMIN_EMAIL, TURNSTILE_SECRET_KEY) are set in
  // Cloudflare and, locally, in .dev.vars.
  "vars": {
    // TODO(FSD-T01): placeholder. Replace with `<team>.cloudflareaccess.com` at admin sign in time (feature 7).
    "ACCESS_TEAM_DOMAIN": "",
  },
  // Worker Previews (`wrangler preview`) do not inherit the settings above, so everything
  // a preview needs is declared here. Previews bind DB to next-build-preview, never production.
  "previews": {
    "observability": { "enabled": true },
    "d1_databases": [
      {
        "binding": "DB",
        // TODO(FSD-T01): placeholder id. Replace with the real `next-build-preview` id.
        "database_name": "next-build-preview",
        "database_id": "00000000-0000-0000-0000-000000000002",
        "migrations_dir": "drizzle",
      },
    ],
    "vars": {
      "ACCESS_TEAM_DOMAIN": "",
    },
    "ratelimits": [
      {
        "name": "POST_RATE_LIMITER",
        "namespace_id": "2003",
        "simple": { "limit": 5, "period": 60 },
      },
      {
        "name": "VOTE_RATE_LIMITER",
        "namespace_id": "2004",
        "simple": { "limit": 60, "period": 60 },
      },
    ],
  },
}
